{
    "$schema": "https://go.kicad.org/api/schemas/v1",
    "identifier": "com.github.drewsum.kipi",
    "name": "KiPI",
    "description": "电源完整性：DC 压降、电流密度、过孔电流与温度 3D 显示，以及 AC PDN 阻抗和耦合噪声分析",
    "runtime": {
        "type": "python",
        "min_version": "3.10"
    },
    "actions": [
        {
            "identifier": "kipi.open",
            "name": "KiPI Power Integrity",
            "description": "Open the KiPI power integrity analyzer",
            "show-button": true,
            "scopes": ["pcb"],
            "entrypoint": "kipi_entry.py",
            "icons-light": ["resources/kipi_24.png", "resources/kipi_48.png"],
            "icons-dark": ["resources/kipi_24.png", "resources/kipi_48.png"]
        }
    ]
}
